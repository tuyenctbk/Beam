    <string name="welcome_title">Welcome to Beam TV</string>
    <string name="welcome_sub">Fast, Wireless Local File Transfer for Android TV</string>
    <string name="welcome_instruction">Beam allows you to send APKs, movies, photos, and music directly from any smartphone or PC browser to your Android TV without cables or internet cloud servers.</string>
    <string name="permission_step_title">Storage Permission Access</string>
    <string name="permission_step_sub">Manage &amp; Save Transferred Files</string>
    <string name="permission_step_instruction">To receive, save, organize, and install APK applications, movies, music, and documents on your Android TV, Beam requires storage access.</string>
    <string name="permission_grant_btn">Grant Storage Access</string>
    <string name="permission_granted_badge">Permission Granted</string>
    <string name="permission_badge">PERMISSIONS</string>
    <string name="permission_granted_instruction">Storage access is active! Beam is ready to save files and install apps on your TV.</string>
    <string name="step1_title">Point Camera at QR Code</string>
    <string name="step1_sub">Instant Web Portal Access from Phone or Laptop</string>
    <string name="step1_instruction">Open your smartphone camera app or browser and point it directly at the QR code on the TV screen. No mobile app download required!</string>
    <string name="step2_title">Drag &amp; Drop + Remote Clipboard</string>
    <string name="step2_sub">Send Files &amp; Sync Text Inputs Instantly</string>
    <string name="step2_instruction">Drag and drop files to stream them to TV storage at full Wi-Fi speeds. Type or paste passwords and URLs in the web portal to sync directly to your TV clipboard.</string>
