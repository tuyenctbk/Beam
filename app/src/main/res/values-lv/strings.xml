    <string name="whats_new_desc">Initial release featuring high-speed Web-to-TV transfers, built-in File Manager, direct USB storage support, and Remote Keyboard input.</string>
    <string name="private_local_title">100% Private &amp; Local</string>
    <string name="private_local_desc">Your files never leave your local home network. No cloud storage, tracking, or external accounts required.</string>
